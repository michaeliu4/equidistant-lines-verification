import Results.EightEquidistantLines.Solution.Family

/-!
# Orthonormal coordinates at a parallel pair

This is the coordinate normalization used at the beginning of the manuscript's
parallel-pair argument. The transverse displacement of a unit-distance parallel
pair supplies the second unit basis vector. Dot products with this vector, the
first direction, and their cross product preserve the defining distance sets.
-/

namespace Results.EightEquidistantLines

open V3

namespace CoordinateFrame

/-- Coordinates in the positively oriented frame generated by `u` and `w`. -/
def coordinates (u w x : V3) : V3 :=
  ⟨dot x u, dot x w, dot x (cross u w)⟩

theorem coordinates_add (u w x y : V3) :
    coordinates u w (x + y) = coordinates u w x + coordinates u w y := by
  ext <;> simp [coordinates, add_dot]

theorem coordinates_smul (u w x : V3) (c : ℝ) :
    coordinates u w (c • x) = c • coordinates u w x := by
  ext <;> simp [coordinates, smul_dot]

theorem coordinates_zero (u w : V3) : coordinates u w 0 = 0 := by
  ext <;> simp [coordinates, dot]

/-- The Gram determinant identity gives preservation of squared lengths. -/
theorem norm2_coordinates (u w x : V3) (hu : norm2 u = 1)
    (hw : norm2 w = 1) (huw : dot u w = 0) :
    norm2 (coordinates u w x) = norm2 x := by
  have h := det_sq x u w
  rw [hu, hw, huw, dot_comm w x] at h
  simp only [det] at h
  change dot x u * dot x u + dot x w * dot x w +
    dot x (cross u w) * dot x (cross u w) = norm2 x
  nlinarith

/-- Dot products are recovered from squared lengths by polarization. -/
theorem dot_coordinates (u w x y : V3) (hu : norm2 u = 1)
    (hw : norm2 w = 1) (huw : dot u w = 0) :
    dot (coordinates u w x) (coordinates u w y) = dot x y := by
  have hexpand (a b : V3) : norm2 (a + b) = norm2 a + 2 * dot a b + norm2 b := by
    simp only [norm2, dot, add_x, add_y, add_z]
    ring
  have h := norm2_coordinates u w (x + y) hu hw huw
  rw [coordinates_add, hexpand, hexpand,
    norm2_coordinates u w x hu hw huw, norm2_coordinates u w y hu hw huw] at h
  linarith

/-- In particular, the coordinate transformation preserves parallel directions. -/
theorem cross_coordinates_eq_zero_iff (u w x y : V3) (hu : norm2 u = 1)
    (hw : norm2 w = 1) (huw : dot u w = 0) :
    cross (coordinates u w x) (coordinates u w y) = 0 ↔ cross x y = 0 := by
  rw [← norm2_eq_zero_iff, norm2_cross, norm2_coordinates u w x hu hw huw,
    norm2_coordinates u w y hu hw huw, dot_coordinates u w x y hu hw huw,
    ← norm2_cross, norm2_eq_zero_iff]

/-- A translated coordinate change preserves each point-pair displacement. -/
theorem coordinates_comb (u w o p v q z : V3) (s t : ℝ) :
    (coordinates u w (p - o) - coordinates u w (q - o)) +
        s • coordinates u w v - t • coordinates u w z =
      coordinates u w ((p - q) + s • v - t • z) := by
  ext <;> simp [coordinates, sub_dot, add_dot, smul_dot]

/-- Equality of the sets defining `sInf` proves line-distance preservation. -/
theorem lineDist_coordinates (u w : V3) (hu : norm2 u = 1)
    (hw : norm2 w = 1) (huw : dot u w = 0) (o p v q z : V3) :
    lineDist3 (coordinates u w (p - o)) (coordinates u w v)
      (coordinates u w (q - o)) (coordinates u w z) = lineDist3 p v q z := by
  unfold lineDist3
  simp_rw [coordinates_comb, norm2_coordinates u w _ hu hw huw]

/-- Applying an orthonormal coordinate frame to every line. -/
noncomputable def transform (F : UFam) (o u w : V3) (hu : norm2 u = 1)
    (hw : norm2 w = 1) (huw : dot u w = 0) : UFam where
  p i := coordinates u w (F.p i - o)
  u i := coordinates u w (F.u i)
  unit i := by rw [norm2_coordinates u w _ hu hw huw]; exact F.unit i
  dist1 i j hij := by
    rw [lineDist_coordinates u w hu hw huw]
    exact F.dist1 i j hij

/-- The orthogonal projection of the second anchor away from the first direction. -/
def transverse (p q u : V3) : V3 := (q - p) - dot (q - p) u • u

theorem transverse_orthogonal (p q u : V3) (hu : norm2 u = 1) :
    dot u (transverse p q u) = 0 := by
  rw [transverse, dot_sub_right, dot_smul_right, ← norm2, hu, dot_comm u (q - p)]
  ring

theorem norm2_transverse (p q u : V3) (hu : norm2 u = 1) :
    norm2 (transverse p q u) = norm2 (q - p) - dot (q - p) u ^ 2 := by
  have hexpand : norm2 (transverse p q u) = norm2 (q - p) -
      2 * dot (q - p) u ^ 2 + dot (q - p) u ^ 2 * norm2 u := by
    simp only [transverse, norm2, dot, sub_x, sub_y, sub_z, smul_x, smul_y, smul_z]
    ring
  rw [hexpand, hu]
  ring

/-- The unit distance of a parallel pair makes its transverse displacement unit. -/
theorem transverse_unit (F : UFam) (a b : Fin 8) (hab : a ≠ b)
    (hpar : cross (F.u a) (F.u b) = 0) :
    norm2 (transverse (F.p a) (F.p b) (F.u a)) = 1 := by
  have hv : F.u b ≠ 0 := by
    intro hzero
    have h := F.unit b
    rw [hzero] at h
    norm_num [norm2, dot] at h
  have hd := F.dist1 a b hab
  rw [lineDist3_parallel _ _ _ _ (F.unit a) hv hpar] at hd
  have hsign : norm2 (F.p a - F.p b) - dot (F.p a - F.p b) (F.u a) ^ 2 =
      norm2 (F.p b - F.p a) - dot (F.p b - F.p a) (F.u a) ^ 2 := by
    simp only [norm2, dot, sub_x, sub_y, sub_z]
    ring
  rw [hsign, ← norm2_transverse _ _ _ (F.unit a)] at hd
  have hs := Real.sq_sqrt (norm2_nonneg (transverse (F.p a) (F.p b) (F.u a)))
  rw [hd] at hs
  norm_num at hs
  exact hs.symm

/-- Coordinates of the first unit frame vector. -/
theorem coordinates_first (u w : V3) (hu : norm2 u = 1) (huw : dot u w = 0) :
    coordinates u w u = (⟨1, 0, 0⟩ : V3) := by
  ext
  · exact hu
  · exact huw
  · exact dot_cross_self_left u w

/-- The second anchor has transverse coordinate equal to the squared displacement. -/
theorem transverse_anchor_y (p q u : V3) (hu : norm2 u = 1) :
    (coordinates u (transverse p q u) (q - p)).y = norm2 (transverse p q u) := by
  have hdecomp : q - p = transverse p q u + dot (q - p) u • u := by
    ext <;> simp [transverse]
  change dot (q - p) (transverse p q u) = norm2 (transverse p q u)
  calc
    _ = dot (transverse p q u + dot (q - p) u • u) (transverse p q u) :=
      congrArg (fun x => dot x (transverse p q u)) hdecomp
    _ = _ := by
      rw [add_dot, smul_dot, transverse_orthogonal p q u hu]
      simp [norm2]

/-- The second anchor lies in the plane spanned by the first two frame vectors. -/
theorem transverse_anchor_z (p q u : V3) :
    (coordinates u (transverse p q u) (q - p)).z = 0 := by
  have hdecomp : q - p = transverse p q u + dot (q - p) u • u := by
    ext <;> simp [transverse]
  change dot (q - p) (cross u (transverse p q u)) = 0
  calc
    _ = dot (transverse p q u + dot (q - p) u • u) (cross u (transverse p q u)) :=
      congrArg (fun x => dot x (cross u (transverse p q u))) hdecomp
    _ = 0 := by rw [add_dot, smul_dot, dot_cross_self_left, dot_cross_self_right]; ring

end CoordinateFrame

namespace UFam

open CoordinateFrame

/-- Normalize a specified parallel pair using its unit transverse displacement.
The first anchor is the origin and its direction is the first coordinate vector;
the second anchor has transverse coordinates `(1, 0)`. -/
theorem exists_parallel_normalization (F : UFam) (a b : Fin 8) (hab : a ≠ b)
    (hpar : cross (F.u a) (F.u b) = 0) :
    ∃ G : UFam, G.p a = 0 ∧ G.u a = (⟨1, 0, 0⟩ : V3) ∧
      (G.p b).y = 1 ∧ (G.p b).z = 0 ∧ cross (G.u a) (G.u b) = 0 := by
  let w := transverse (F.p a) (F.p b) (F.u a)
  have hw : norm2 w = 1 := transverse_unit F a b hab hpar
  have huw : dot (F.u a) w = 0 := transverse_orthogonal _ _ _ (F.unit a)
  let G := transform F (F.p a) (F.u a) w (F.unit a) hw huw
  refine ⟨G, ?_, ?_, ?_, ?_, ?_⟩
  · change coordinates (F.u a) w (F.p a - F.p a) = 0
    have hz : F.p a - F.p a = 0 := by ext <;> simp
    rw [hz, coordinates_zero]
  · exact coordinates_first _ _ (F.unit a) huw
  · change (coordinates (F.u a) w (F.p b - F.p a)).y = 1
    rw [transverse_anchor_y _ _ _ (F.unit a)]
    exact hw
  · exact transverse_anchor_z _ _ _
  · exact (cross_coordinates_eq_zero_iff _ _ _ _ (F.unit a) hw huw).2 hpar

end UFam

end Results.EightEquidistantLines
